name: TTS CPU contracts
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: tts-tests-${{ github.ref }}
  cancel-in-progress: true

jobs:
  cpu-unittest:
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        test_file:
          - test_tts_policy_batch.py
          - test_tts_checkpoint_conversion.py
          - test_tts_objectives.py
          - test_tts_protocols.py
          - test_tts_gpu_guard.py
          - test_dp_schedule.py
          - test_cp_utils.py
          - test_loss_cp_invariance.py
          - test_metric_report.py
          - test_metric_report_dist.py
          - test_ppo_logprob_entropy.py
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - name: Install CPU test environment
        run: |
          python -m pip install 'torch==2.9.1' --index-url https://download.pytorch.org/whl/cpu
          python -m pip install -r requirements.txt pytest
          python -m pip install -e . --no-deps
      - name: Run the registered test entry point
        env:
          PYTHONPATH: .
          TOKENIZERS_PARALLELISM: 'false'
        run: python tests/${{ matrix.test_file }}
