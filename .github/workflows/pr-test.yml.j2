name: TTS CPU contracts
on:
  pull_request:
    branches: [main, tts-rl, chore/tts-rl-prune-all]
  push:
    branches: [main, tts-rl]
  workflow_dispatch:

concurrency:
  group: tts-tests-${{ github.ref }}
  cancel-in-progress: true

jobs:
  cpu-unittest:
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        test_file:
          - test_tts_policy_batch.py
          - test_tts_checkpoint_conversion.py
          - test_tts_objectives.py
          - test_tts_protocols.py
          - test_tts_gpu_guard.py
          - test_tts_reward_wer.py
          - test_tts_reward_runtime.py
          - test_tts_reward_judge.py
          - test_tts_sim_service.py
          - test_tts_inspire_serving.py
          - test_tts_data_eval.py
          - test_tts_rollout_services.py
          - test_tts_launch.py
          - test_dp_schedule.py
          - test_cp_utils.py
          - test_loss_cp_invariance.py
          - test_metric_report.py
          - test_metric_report_dist.py
          - test_ppo_logprob_entropy.py
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - name: Install CPU test environment
        run: |
          python -m pip install 'torch==2.9.1' 'torchaudio==2.9.1' --index-url https://download.pytorch.org/whl/cpu
          python -m pip install -r requirements.txt pytest
          python -m pip install -e '.[tts-sim]'
      - name: Prepare shared paths for Inspire contracts
        if: matrix.test_file == 'test_tts_inspire_serving.py'
        run: |
          # These contracts validate existing shared /inspire paths.
          sudo install -d -m 0755 -o "$USER" /inspire/slime-ci
          cp -a "$GITHUB_WORKSPACE/." /inspire/slime-ci/
      - name: Run the registered test entry point
        working-directory: ${{ matrix.test_file == 'test_tts_inspire_serving.py' && '/inspire/slime-ci' || github.workspace }}
        env:
          PYTHONPATH: .
          TOKENIZERS_PARALLELISM: 'false'
        run: python tests/${{ matrix.test_file }}
